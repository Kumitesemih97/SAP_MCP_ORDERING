{
  "name": "sap-mcp-ordering-system",
  "version": "2.1.0",
  "description": "SAP MCP Ordering System with Gemma4 31B AI Integration",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node_modules/.bin/tsc && node_modules/.bin/tsx server.ts",
    "dev": "node_modules/.bin/tsc && node_modules/.bin/nodemon --exec node_modules/.bin/tsx server.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "compile": "tsc && npm run copy-static",
    "copy-static": "cp public/index.html public/styles.css dist/public/ 2>/dev/null || :",
    "clean": "rm -rf dist public/*.js public/*.js.map public/*.d.ts",
    "lint": "eslint src/**/*.ts server.ts --fix",
    "type-check": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "setup": "npm install && npm run build",
    "serve": "npm run build && npm start",
    "debug": "node --inspect node_modules/.bin/tsx server.ts"
  },
  "keywords": [
    "sap",
    "mcp",
    "ordering",
    "ai",
    "gemma4",
    "ollama",
    "typescript",
    "node.js",
    "express"
  ],
  "author": "SAP MCP Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.3",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/sap-mcp-ordering-system.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/sap-mcp-ordering-system/issues"
  },
  "homepage": "https://github.com/your-org/sap-mcp-ordering-system#readme",
  "nodemonConfig": {
    "watch": [
      "src",
      "server.ts",
      "mcp-client.ts"
    ],
    "ext": "ts,json",
    "ignore": [
      "public/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "exec": "node_modules/.bin/tsx server.ts"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "warn",
      "@typescript-eslint/no-explicit-any": "warn",
      "prefer-const": "error",
      "no-var": "error"
    }
  }
}
